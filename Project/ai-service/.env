# Copie este arquivo para ".env" e ajuste.

# De onde vêm os dados de treino:
#   csv       -> lê o arquivo gerado pelo seed (bom para testar sem Firebase)
#   firestore -> lê a coleção occupancy_readings do Firestore (uso real)
DATA_SOURCE=firestore

# Usado quando DATA_SOURCE=csv (caminho relativo à pasta Project/ai-service)
DATA_CSV_PATH=../../tools/seed_output/occupancy_readings.csv

# Usado quando DATA_SOURCE=firestore (a mesma chave do seed_firestore.py)
FIREBASE_KEY_PATH=../../tools/serviceAccountKey.json

# Os DADOS lidos do Firestore ficam em cache por N segundos (economiza leituras
# do plano gratuito: 50 mil/dia). Os MODELOS são retreinados em TODA requisição.
DATA_CACHE_SECONDS=600

# Quantos dias de histórico buscar / quantos dias finais usar para medir o MAE
HISTORY_DAYS=60
VALIDATION_DAYS=7

# true = só responde para usuários logados no app (token do Firebase Auth).
# Deixe false no desenvolvimento local; ligue antes de publicar o serviço.
REQUIRE_AUTH=false
